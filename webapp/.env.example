# Postgres local de desenvolvimento (ver README para criar o role/BD).
# Em produção, aponta para o Postgres da VPS (ver webapp/deploy/DEPLOY.md).
DATABASE_URL="postgresql://studioxxvii:TROCA_ESTA_PASSWORD@localhost:5432/studioxxvii?schema=public"

# Gerar um valor novo para produção: openssl rand -base64 32
NEXTAUTH_SECRET="troca-isto"
NEXTAUTH_URL="http://localhost:3000"

# Usado para o sitemap.xml, robots.txt e URLs canónicas/Open Graph.
SITE_URL="https://studioxxvii.pt"

# --- Segurança ---
# Em produção a app NÃO arranca se o NEXTAUTH_SECRET tiver menos de 32 caracteres ou for "troca-isto".
# Password inicial do barbeiro ao correr `npm run seed` (se vazio, é gerada ao acaso e mostrada uma vez).
SEED_PASSWORD=""

# Só em plataformas SEM nginx (Render, Railway...): nº de proxies da plataforma à frente da app (normalmente 1).
# Serve para os limites de pedidos verem o IP real do cliente. Com o nginx do deploy/ deixar vazio (usa X-Real-IP).
TRUSTED_PROXY_HOPS=""

# --- Notificações por WhatsApp (Twilio) — opcional, desligado por omissão ---
# Sem estas variáveis, as notificações ficam só em log (nada é enviado).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
